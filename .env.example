# --- AWS S3 (프로필 이미지 등 파일 업로드) ---
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# --- 구글 OAuth 로그인 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 카카오 OAuth 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- TMDB (영화/TV 콘텐츠 수집) ---
TMDB_API_KEY=

# JWT 서명 키
JWT_SECRET=

# 스포츠 경기 정보 API
SPORTSDB_API_KEY=

# 메일 발송 (비밀번호 재설정 등)
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
MAIL_FROM=

# 에러 알림용 디스코드 웹훅
DISCORD_WEBHOOK_URL=

# Kafka 광고 호스트. 로컬은 localhost, 외부 접속 시 해당 머신의 IP/도메인
DOMAIN_HOST=localhost

# Elasticsearch 보안/SSL 로컬은 끈 상태가 기본
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_SSL_ENABLED=false
ELASTICSEARCH_PORT=19201

# 위 보안 옵션을 true 로 켤 때만 필요
ELASTIC_PASSWORD=
