# 홈 서버(/opt/mople/.env)용. docker-compose.prod.yml

# --- Postgres ---
DB_USERNAME=
DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO 루트 계정 겸 앱의 S3 키 ---
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# --- 구글 OAuth 로그인 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 카카오 OAuth 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- TMDB (영화/TV 콘텐츠 수집) ---
TMDB_API_KEY=

# 스포츠 경기 정보 API
SPORTSDB_API_KEY=

# JWT 서명 키
JWT_SECRET=

# 관리자 계정 비밀번호
ADMIN_PASSWORD=

# 메일 발송 (비밀번호 재설정 등)
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
MAIL_FROM=

# 에러 알림용 디스코드 웹훅
DISCORD_WEBHOOK_URL=

#
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
# SPRING_BATCH_JDBC_INITIALIZE_SCHEMA=always
